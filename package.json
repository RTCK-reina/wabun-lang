{
  "name": "wabun-lang",
  "version": "1.4.0",
  "description": "和文 (wabun) — a programming language whose syntax follows classical Japanese (bungo) grammar. Compiles to JavaScript.",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "wabun": "bin/wabun.js"
  },
  "scripts": {
    "test": "node test/run.js",
    "build": "node scripts/build-playground.js",
    "repl": "node bin/wabun.js repl",
    "example": "node bin/wabun.js run examples/hello.wb"
  },
  "keywords": [
    "esolang",
    "japanese",
    "classical-japanese",
    "bungo",
    "kobun",
    "haiku",
    "language",
    "transpiler"
  ],
  "author": "RTCK",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RTCK-reina/wabun-lang.git"
  },
  "bugs": {
    "url": "https://github.com/RTCK-reina/wabun-lang/issues"
  },
  "homepage": "https://rtck-reina.github.io/wabun-lang/",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "src",
    "bin",
    "playground",
    "dist",
    "examples",
    "docs",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ]
}
